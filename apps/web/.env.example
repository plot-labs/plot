# Local web runtime
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
PLOT_API_BASE_URL=http://127.0.0.1:8080
# Absolute origin the BFF expects on state-changing browser requests.
# Set this in production so CSRF checks do not trust the client Host header;
# unset locally, the request host is used instead.
# PLOT_APP_ORIGIN=https://app.useplot.xyz

# WorkOS AuthKit server-side session boundary.
WORKOS_AUTH_ENABLED=false
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_COOKIE_NAME=wos-session
WORKOS_COOKIE_SAMESITE=lax
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# This is the web origin allowlist used by the AuthKit BFF and CSRF checks.
PLOT_WORKOS_ALLOWED_ORIGINS=http://127.0.0.1:3000
PLOT_WORKOS_SESSION_COOKIE_NAME=wos-session

# Waitlist email delivery
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=
RESEND_FROM_EMAIL=
