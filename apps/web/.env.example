# Local web runtime
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
PLOT_API_BASE_URL=http://127.0.0.1:8080
# Absolute origin the BFF expects on state-changing browser requests.
# Set this in production so CSRF checks do not trust the client Host header;
# unset locally, the request host is used instead.
# PLOT_APP_ORIGIN=https://app.useplot.xyz

# Better Auth and PostgreSQL
# Keep this port aligned with the API's local PostgreSQL port.
BETTER_AUTH_DATABASE_URL=postgresql://plot:secret@127.0.0.1:5433/plot
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTH_ALLOWED_EMAILS=you@example.com

# GitHub OAuth App used only for Plot sign-in
# Callback URL: http://127.0.0.1:3000/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# JWTs issued by Better Auth for the Kotlin resource server
PLOT_AUTH_JWT_ISSUER=http://127.0.0.1:3000
PLOT_AUTH_JWT_AUDIENCE=plot-api

# Waitlist email delivery
RESEND_API_KEY=
RESEND_WAITLIST_SEGMENT_ID=
RESEND_FROM_EMAIL=
