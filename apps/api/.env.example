# PostgreSQL
# Local PostgreSQL published by apps/api/compose.yaml.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/plot
SPRING_DATASOURCE_USERNAME=plot
SPRING_DATASOURCE_PASSWORD=secret

# Kotlin auth (OAuth, session, JWT/JWKS)
PLOT_AUTH_ENABLED=true
PLOT_AUTH_REQUIRED=true
PLOT_AUTH_ISSUER=http://127.0.0.1:3000
PLOT_AUTH_AUDIENCE=plot-api
PLOT_AUTH_GITHUB_CLIENT_ID=
PLOT_AUTH_GITHUB_CLIENT_SECRET=
PLOT_AUTH_ALLOWED_EMAILS=you@example.com
PLOT_AUTH_SESSION_COOKIE_NAME=plot.session
PLOT_AUTH_SESSION_TTL=30d
# Leave empty for host-only cookies in local dev.
PLOT_AUTH_COOKIE_DOMAIN=
PLOT_AUTH_APP_ORIGIN=http://127.0.0.1:3000
# Browser-facing auth origin. Local dev uses the Next.js /api/auth proxy on :3000.
PLOT_AUTH_API_ORIGIN=http://127.0.0.1:3000
PLOT_AUTH_JWT_TTL=15m

# GitHub App
# App setup URL: http://127.0.0.1:3000/api/plot/github/installations/callback
# Webhook URL: http://127.0.0.1:8080/api/github/webhook
# External providers require a tunnel to reach a local webhook URL.
# Required repository permissions: Metadata read-only, Contents read-only,
# Pull requests read-only. Subscribe to Push, Release, and Repository events.
PLOT_GITHUB_APPID=
PLOT_GITHUB_APPSLUG=
# Store a one-line PKCS#8 DER value encoded with Base64.
PLOT_GITHUB_PRIVATEKEY=
# Generate these independently with: openssl rand -hex 32
PLOT_GITHUB_STATESECRET=
PLOT_GITHUB_WEBHOOKSECRET=

# OpenRouter-backed generation
SPRING_AI_OPENAI_APIKEY=

# Polar subscription webhook
PLOT_POLAR_WEBHOOKSECRET=

# OpenTelemetry is disabled by default for local development.
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Example: Authorization=Basic <base64-public-key-colon-secret-key>
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_SERVICE_NAME=plot-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
